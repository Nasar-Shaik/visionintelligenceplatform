# OS artifacts
.DS_Store
Thumbs.db

# Secrets & env (never commit — use the vault; see docs/architecture/15-SECURITY-ARCHITECTURE.md)
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
secrets/
# ⚠️ Backup directories hold `config.env` — a verbatim copy of the production environment, including
# the credential-encryption key. `backup.sh` writes it 0600; committing one would publish it.
backups/
# Local runtime data: the `local` evidence provider's store and generated demo clips.
.data/

# Node / TS
node_modules/
dist/
build/
.turbo/
*.tsbuildlog
*.tsbuildinfo
coverage/

# Python / AI
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/
*.onnx
*.engine
*.trt

# Generated contract artifacts (reproducible via `pnpm --filter @vip/contracts codegen`)
packages/*/generated/

# ML artifacts (belong in the registry / object storage, not the repo)
mlruns/
.dvc/cache/
.dvc/tmp/
.dvc/config.local
# Root-level datasets dir only — ai/datasets/ is DVC-tracked (keeps *.dvc pointers +
# READMEs; DVC writes a per-dir .gitignore for the actual bytes).
/datasets/
models/weights/

# Infra / local
*.tfstate
*.tfstate.*
.terraform/
docker-compose.override.yml

# Logs & temp
*.log
tmp/
.cache/

# AI Playground CLI output (engineering artifacts — never committed)
playground-output/

# Local agent tooling (Claude Code skills). Not project code — installed per
# machine, third-party content with its own licences. Delete this line if the
# team decides to share a skill set through the repo.
.claude/

# Unattended verification: generated evidence and the live-log pointer.
#
# ⚠️ scripts/reports/ is ignored for a load-bearing reason, not tidiness: `deployment-integrity.mjs`
# asserts "the working tree is clean — what is deployed can be named by a commit hash". Untracked
# report output makes that check red on every run, so the framework would fail a real verification by
# producing its own output. The runs are still on disk to read; they are simply not repository state.
scripts/logs/
scripts/reports/

# ── P-8 Phase 4 tracking fixtures ────────────────────────────────────────────────────────────────
# Generated by docs/review/p8/tracking-fixtures.mjs from scene-people.jpg plus the boxes the DEPLOYED
# model returns. ⚠️ The clips are deliberately NOT committed: they are ~1 MB of derived binary that
# any machine can rebuild in twenty seconds, and a committed video is a thing that silently stops
# matching the generator that claims to produce it. `ground-truth.json` IS committed — it is the
# authored contract the assertions are written against, and it must be reviewable in a diff.
infra/docker/fixtures/media/tracking/*.mp4
infra/docker/fixtures/media/tracking/*.png
infra/docker/fixtures/media/tracking/frames/
