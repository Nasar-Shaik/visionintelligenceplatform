{
  "name": "vision-intelligence-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise multi-tenant Vision Intelligence Platform (monorepo root). Architecture frozen v1.0 \u2014 see docs/.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:imports": "node tools/import-graph/check-imports.mjs",
    "verify:contracts": "node tools/contracts/verify-schemas.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "dev:stack": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:stack:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:stack:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "dev:all": "turbo run dev --concurrency=15",
    "dev:services": "turbo run dev --filter=./services/* --concurrency=12",
    "dev:web": "pnpm --filter @vip/console dev",
    "seed": "pnpm --filter @vip/seed start",
    "seed:evidence": "pnpm --filter @vip/seed evidence",
    "seed:demo": "pnpm --filter @vip/seed demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
