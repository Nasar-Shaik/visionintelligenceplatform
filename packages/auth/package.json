{
  "name": "@vip/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Authentication primitives (Phase 1, P1-2): password hashing (node scrypt, no native build), access-token sign/verify (jose, HS256), and opaque refresh-token minting/hashing. Pure + testable. See docs/architecture/phase1/AUTHENTICATION.md, 15-SECURITY.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vip/contracts": "workspace:*",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
