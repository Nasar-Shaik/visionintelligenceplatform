{
  "name": "@vip/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of integration truth: versioned Zod schemas + generated types for events, capabilities, config, and API envelopes. See docs/architecture (00 §7, 05, 06, 09, 21).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "generated"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "codegen": "tsx scripts/generate-json-schema.ts",
    "clean": "rm -rf dist generated"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
