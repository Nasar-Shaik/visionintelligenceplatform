{
  "name": "@vip/service-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API gateway (Phase 1, P1-2) — the single trust boundary: validates the access token at the edge, resolves the TenantContext, and forwards it to upstream services as signed internal headers (stripping any client-supplied ones). See docs/architecture/phase1/AUTHENTICATION.md, 23-SERVICE-OWNERSHIP.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@vip/auth": "workspace:*",
    "@vip/config": "workspace:*",
    "@vip/contracts": "workspace:*",
    "@vip/messaging": "workspace:*",
    "@vip/permissions": "workspace:*",
    "fastify": "^5.10.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
