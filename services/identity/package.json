{
  "name": "@vip/service-identity",
  "version": "0.1.0",
  "private": true,
  "description": "Identity context service — reference Fastify service template (transport→application→domain→adapters). Phase 0 scaffold: infra endpoints only, no auth/business logic yet. See docs/architecture/23 (identity), docs/ai/IMPLEMENTATION_GUIDE.md.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@vip/auth": "workspace:*",
    "@vip/config": "workspace:*",
    "@vip/contracts": "workspace:*",
    "@vip/permissions": "workspace:*",
    "@vip/tenancy": "workspace:*",
    "fastify": "^5.10.0",
    "mongodb": "^7.5.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
