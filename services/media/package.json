{
  "name": "@vip/service-media",
  "version": "0.1.0",
  "private": true,
  "description": "Media / ingestion service (Phase 1, P1-4) — per-camera stream workers: connect RTSP/RTMP (creds resolved from camera), decode (ffmpeg, H.264), extract frames for perception, and record segments to tenant-scoped object storage (@vip/storage) under {tenantId}/{cameraId}/…. Auto-reconnect with backoff; emits media.stream.* events. See docs/architecture/phase1/INGESTION_PIPELINE.md, STORAGE_ARCHITECTURE.md.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude '**/*integration.test.ts' --exclude '**/*.nightly.test.ts'",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@vip/auth": "workspace:*",
    "@vip/config": "workspace:*",
    "@vip/contracts": "workspace:*",
    "@vip/messaging": "workspace:*",
    "@vip/permissions": "workspace:*",
    "@vip/storage": "workspace:*",
    "@vip/tenancy": "workspace:*",
    "fastify": "^5.10.0",
    "mongodb": "^7.5.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
