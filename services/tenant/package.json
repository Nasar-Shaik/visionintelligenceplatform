{
  "name": "@vip/service-tenant",
  "version": "0.1.0",
  "private": true,
  "description": "Tenant service (Phase 1, P1-1) — provisions tenants and their org-hierarchy root; the root of all data. Enforces fail-closed multi-tenant isolation via @vip/tenancy. See docs/architecture/phase1/TENANT_ARCHITECTURE.md, 23-SERVICE-OWNERSHIP.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude '**/*integration.test.ts'",
    "test:watch": "vitest",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@vip/config": "workspace:*",
    "@vip/contracts": "workspace:*",
    "@vip/tenancy": "workspace:*",
    "fastify": "^5.10.0",
    "mongodb": "^7.5.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
