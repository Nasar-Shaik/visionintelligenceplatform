{
  "analyzerCosts": {
    "costs": {
      "fire": 3.0,
      "intrusion": 1.5,
      "loitering": 1.5,
      "occupancy": 1.0
    },
    "protectedAnalyzers": ["intrusion", "fire"]
  },
  "defaultPriority": "normal",
  "description": "Large indoor space, many cameras, safety-oriented. Throughput over latency; intrusion and fire must never be disabled.",
  "dropPolicy": "drop-oldest",
  "enabledBehaviors": ["intrusion", "loitering", "occupancy", "fire"],
  "health": {
    "degradedBelow": 80,
    "predictiveDegradation": true,
    "projectionHorizonSamples": 3,
    "stabilizationSamples": 3,
    "trendWindowSamples": 5,
    "unhealthyBelow": 50
  },
  "maxSessions": 16,
  "preferredStreamProfile": "sub",
  "profile": "warehouse",
  "queueCapacity": 48,
  "reconnect": {
    "baseMs": 500,
    "maxAttempts": 10,
    "maxMs": 30000
  },
  "recovery": {
    "autoRecoverCategories": ["connection", "model"],
    "baseCooldownMs": 5000,
    "maxCooldownMs": 300000,
    "maxRestarts": 10,
    "restartWindowSeconds": 3600,
    "stabilizationSeconds": 30
  },
  "scheduler": {
    "admissionControl": true,
    "degradeAboveQueuePercent": 80,
    "maxBatchSize": 1,
    "maxConsecutivePerSession": 4,
    "minDegradedFps": 1,
    "predictive": true,
    "recoverBelowQueuePercent": 50,
    "reservedCapacityPercent": 10,
    "strategy": "weighted-fair"
  },
  "targetEventLatencyMs": 1000,
  "targetFps": 4,
  "version": "1.0.0"
}
