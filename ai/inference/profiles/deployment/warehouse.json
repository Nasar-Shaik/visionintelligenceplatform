{
  "analyzerCosts": {
    "costs": {
      "fire": 3.0,
      "intrusion": 1.5,
      "loitering": 1.5,
      "occupancy": 1.0
    },
    "protectedAnalyzers": ["intrusion", "fire"]
  },
  "defaultPriority": "normal",
