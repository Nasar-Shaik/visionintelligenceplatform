# -----------------------------------------------------------------------------
# VIP environment configuration — copy to .env and adjust.
#
# `.env` is the ONLY secrets source (ADR-0018): no Vault, no cloud secret manager,
# no external dependency. Deployment is: copy this file → edit values → compose up.
# In production the orchestrator injects these as real environment variables (no file).
# `.env` is gitignored — NEVER commit real secrets. These dev values are intentionally
# weak and MUST NOT resemble production. Config is loaded/validated by @vip/config.
# -----------------------------------------------------------------------------

# NOTE: Host ports use a dedicated non-standard 4xxxx range to AVOID COLLISIONS
# with other local Docker projects (e.g. MERN stacks on 27017/6379/9000).
# Container-internal ports remain standard; only host mappings are shifted.
# Change the *_PORT values if these also collide on your machine.

# --- MongoDB (OLTP) --- host 47017 -> container 27017
MONGO_PORT=47017
MONGO_USER=vip_dev
MONGO_PASSWORD=change_me_dev_only
# Connection string for services:
MONGO_URI=mongodb://vip_dev:change_me_dev_only@localhost:47017/vip?authSource=admin

# --- Redis (cache/state/queue) --- host 46379 -> container 6379
REDIS_PORT=46379
REDIS_PASSWORD=change_me_dev_only
REDIS_URL=redis://:change_me_dev_only@localhost:46379

# --- MinIO (object storage, S3-compatible) --- host 49000/49001
MINIO_PORT=49000
MINIO_CONSOLE_PORT=49001
MINIO_ROOT_USER=vip_dev
MINIO_ROOT_PASSWORD=change_me_dev_only
S3_ENDPOINT=http://localhost:49000

# --- NATS + JetStream (event backbone, ADR-0016) --- host 44222/48222
NATS_PORT=44222
NATS_MONITOR_PORT=48222
NATS_URL=nats://localhost:44222

# --- MLflow: Model Registry + experiment tracking (docs/architecture/08 §2) ---
# host 45000 -> container 5000. Clients only need MLFLOW_TRACKING_URI (artifacts
# are proxied by the server via --serve-artifacts).
MLFLOW_PORT=45000
MLFLOW_TRACKING_URI=http://localhost:45000
MLFLOW_ARTIFACTS_BUCKET=mlflow-artifacts
# MLflow backend store (Postgres) --- host 45432 -> container 5432
MLFLOW_DB_PORT=45432
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change_me_dev_only
MLFLOW_DB_NAME=mlflow

# --- S3 credentials for host-side tools (DVC, direct MLflow artifact access) ---
# In dev these map to the MinIO root credentials above. Host endpoint (49000).
AWS_ACCESS_KEY_ID=vip_dev
AWS_SECRET_ACCESS_KEY=change_me_dev_only
MLFLOW_S3_ENDPOINT_URL=http://localhost:49000

# --- DVC: Dataset Registry remote (MinIO bucket) (docs/architecture/08 §3) ---
DVC_REMOTE_BUCKET=vip-datasets

# --- JWT / tokens (consumed from P1 when identity issues tokens) ---
# JWT_SECRET must be >= 16 chars; generate a strong random value per environment.
JWT_SECRET=change_me_dev_only_min_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Runtime (@vip/config app group) ---
NODE_ENV=development
LOG_LEVEL=debug
# SERVICE_NAME / HOST / PORT are set per service (defaults in @vip/config).
