# -----------------------------------------------------------------------------
# VIP environment configuration — copy to .env and adjust.
#
# `.env` is the ONLY secrets source (ADR-0018): no Vault, no cloud secret manager,
# no external dependency. Deployment is: copy this file → edit values → compose up.
# In production the orchestrator injects these as real environment variables (no file).
# `.env` is gitignored — NEVER commit real secrets. These dev values are intentionally
# weak and MUST NOT resemble production. Config is loaded/validated by @vip/config.
# -----------------------------------------------------------------------------

# NOTE: Host ports use a dedicated non-standard 4xxxx range to AVOID COLLISIONS
# with other local Docker projects (e.g. MERN stacks on 27017/6379/9000).
# Container-internal ports remain standard; only host mappings are shifted.
# Change the *_PORT values if these also collide on your machine.

# --- MongoDB (OLTP) --- host 47017 -> container 27017
MONGO_PORT=47017
MONGO_USER=vip_dev
MONGO_PASSWORD=change_me_dev_only
# Connection string for services:
MONGO_URI=mongodb://vip_dev:change_me_dev_only@localhost:47017/vip?authSource=admin

# --- Redis (cache/state/queue) --- host 46379 -> container 6379
REDIS_PORT=46379
REDIS_PASSWORD=change_me_dev_only
REDIS_URL=redis://:change_me_dev_only@localhost:46379

# --- MinIO (object storage, S3-compatible) --- host 49000/49001
MINIO_PORT=49000
MINIO_CONSOLE_PORT=49001
MINIO_ROOT_USER=vip_dev
MINIO_ROOT_PASSWORD=change_me_dev_only
S3_ENDPOINT=http://localhost:49000

# --- NATS + JetStream (event backbone, ADR-0016) --- host 44222/48222
NATS_PORT=44222
NATS_MONITOR_PORT=48222
NATS_URL=nats://localhost:44222

# --- MLflow: Model Registry + experiment tracking (docs/architecture/08 §2) ---
# host 45000 -> container 5000. Clients only need MLFLOW_TRACKING_URI (artifacts
# are proxied by the server via --serve-artifacts).
MLFLOW_PORT=45000
MLFLOW_TRACKING_URI=http://localhost:45000
MLFLOW_ARTIFACTS_BUCKET=mlflow-artifacts
# MLflow backend store (Postgres) --- host 45432 -> container 5432
MLFLOW_DB_PORT=45432
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change_me_dev_only
MLFLOW_DB_NAME=mlflow

# --- S3 credentials for host-side tools (DVC, direct MLflow artifact access) ---
# In dev these map to the MinIO root credentials above. Host endpoint (49000).
AWS_ACCESS_KEY_ID=vip_dev
AWS_SECRET_ACCESS_KEY=change_me_dev_only
MLFLOW_S3_ENDPOINT_URL=http://localhost:49000

# --- DVC: Dataset Registry remote (MinIO bucket) (docs/architecture/08 §3) ---
DVC_REMOTE_BUCKET=vip-datasets

# --- JWT / tokens (consumed from P1 when identity issues tokens) ---
# JWT_SECRET must be >= 16 chars; generate a strong random value per environment.
JWT_SECRET=change_me_dev_only_min_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Secret vaulting (@vip/crypto; camera credentials at rest, P1-3) ---
# Derives the AES-256-GCM data key (scrypt). Must be >= 16 chars, high-entropy, and STABLE:
# rotating it orphans previously encrypted credentials. `.env` only (ADR-0018) — no external KMS.
CREDENTIAL_ENCRYPTION_KEY=change_me_dev_only_min_16_chars

# --- Internal service-to-service auth (@vip/config internal group, P1-4) ---
# Shared key authenticating internal calls (e.g. media → camera credential resolve). >= 16 chars.
# The gateway strips any client-supplied `x-internal-key`, so only trusted services can use it.
INTERNAL_API_KEY=change_me_dev_only_min_16_chars

# --- Object storage recordings (@vip/storage; media ingestion, P1-4) ---
S3_RECORDINGS_BUCKET=vip-recordings
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true            # true for MinIO; false for AWS virtual-host buckets

# --- Media ingestion tunables (@vip/service-media, P1-4) ---
# MEDIA_FRAME_RATE=2                  # frames/sec handed to perception
# MEDIA_SEGMENT_SECONDS=6            # recording segment length
# FFMPEG_BINARY=ffmpeg               # system ffmpeg used by the decoder
# RTSP_PORT=8554                     # dev-stack `media` profile RTSP test source (rtsp://localhost:8554/test)

# --- Inference capability runtime (ai/inference, Python, P1-6) ---
# Capabilities are loaded from manifests (ai/inference/manifests). Reuses INTERNAL_API_KEY + MLFLOW_*.
# INFERENCE_BACKEND=stub             # "stub" (dependency-free default) | "onnx" (real ONNX + MLflow)
# INFERENCE_MANIFESTS_DIR=...        # defaults to ai/inference/manifests
# PORT=8085                          # inference service port
# INFERENCE_EVENT_SINK=null          # "null" (default) | "nats" (publish detections onto the backbone, P1-5)
#                                    # the "nats" sink uses NATS_URL and needs nats-py (requirements.txt)

# --- Event pipeline (@vip/service-events, P1-5) ---
# Consumes capability outputs off NATS (NATS_URL), persists to Mongo (MONGO_URI), re-publishes event.persisted.
# EVENTS_DEDUP_WINDOW_MS=10000       # collapse repeats of the same (type, track/class, zone) within this window
# EVENTS_REPLAY_CEILING=10000        # hard cap on POST /events/replay regardless of request limit
# PORT=8084                          # events service port

# --- Rule engine (@vip/service-rules, P1-7) ---
# Consumes event.persisted off NATS, evaluates versioned tenant rules, emits incident.candidate/rule.matched.
# RULES_MAX_PER_EVENT=1000           # cap on enabled rules evaluated per event
# RULES_CANDIDATE_DEDUP_WINDOW_MS=60000  # collapse identical incident candidates within this window
# PORT=8086                          # rules service port

# --- Gateway upstreams (service base URLs; @vip/service-gateway) ---
# IDENTITY_URL=http://localhost:8080
# TENANT_URL=http://localhost:8081
# CAMERA_URL=http://localhost:8082
# MEDIA_URL=http://localhost:8083
# EVENTS_URL=http://localhost:8084
# RULES_URL=http://localhost:8086

# --- Runtime (@vip/config app group) ---
NODE_ENV=development
LOG_LEVEL=debug
# SERVICE_NAME / HOST / PORT are set per service (defaults in @vip/config).
