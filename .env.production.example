# -----------------------------------------------------------------------------
# Production environment for the Vision Intelligence Platform (P-5.8).
#
#   cp .env.production.example .env.production
#   # generate every secret below — see docs/guides/DEPLOYMENT.md
#   docker compose -f infra/docker/docker-compose.prod.yml --env-file .env.production up -d --build
#
# ⚠️ This file has NO working defaults, and that is deliberate. `docker-compose.prod.yml` declares
# every secret with `${VAR:?}`, so compose refuses to start until each one is set. The alternative —
# a development fallback — produces a system that comes up looking healthy while signing its tokens
# with a key that is published in this repository.
#
# ⚠️ `.env.production` is gitignored. It is also the ONLY secrets source (ADR-0018): there is no
# Vault, no cloud secret manager, nothing to reach for. Back it up (see docs/guides/BACKUP.md §3) —
# CREDENTIAL_ENCRYPTION_KEY cannot be regenerated without orphaning every stored camera credential.
# -----------------------------------------------------------------------------

# --- Public identity -----------------------------------------------------------
# The URL operators type. It is the Caddy site address, so it also decides TLS:
#   https://vip.example.com   → Caddy obtains a real certificate via ACME (needs public DNS + :443)
#   https://localhost         → Caddy's internal CA (valid TLS, locally-trusted root)
#   http://vip.example.com    → plaintext. Do not. Signed cookies and HSTS both assume TLS.
VIP_PUBLIC_URL=https://localhost
VIP_HTTP_PORT=80
VIP_HTTPS_PORT=443

# --- Secrets -------------------------------------------------------------------
# Generate each independently. `openssl rand -hex 32` (or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Never reuse one value across two variables: they have different lifetimes and different blast radii.

# Signs and verifies access/refresh tokens. Rotating it logs every operator out — that is all.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ⚠️ Derives the AES-256-GCM key that encrypts camera credentials at rest. Rotating it does NOT
# re-encrypt: every previously stored credential becomes permanently unreadable. Treat as the one
# irreplaceable secret in this file.
CREDENTIAL_ENCRYPTION_KEY=

# Authenticates service-to-service calls. The gateway strips any client-supplied `x-internal-key`,
# so this never travels through a browser — but a leak still grants internal-caller authority.
INTERNAL_API_KEY=

# --- Datastores ----------------------------------------------------------------
# Reachable only on the compose network; no host ports are published for any of them.
MONGO_USER=vip
MONGO_PASSWORD=
REDIS_PASSWORD=

# Object storage (evidence + recordings).
MINIO_ROOT_USER=vip
MINIO_ROOT_PASSWORD=
S3_RECORDINGS_BUCKET=vip-recordings

# --- Tunables ------------------------------------------------------------------
# `info` in production. `debug` logs request bodies, which is how evidence metadata and tenant
# identifiers end up in a log aggregator that has no tenant isolation of its own.
LOG_LEVEL=info

# Playback/download URL lifetime, seconds (30–86400). Shorter is safer: a signed URL is a bearer
# token for one object, and 900s is long enough to start a clip but not to be shared usefully.
EVIDENCE_DOWNLOAD_TTL_SECONDS=900

# --- First-run bootstrap (profile: seed) ---------------------------------------
# Consumed only by `--profile seed run --rm seed`. Change the password before first login; the
# seed's own default is a development value and the guide says so in the same breath.
SEED_TENANT_ID=tnt_dev
SEED_EMAIL=owner@vip.dev
SEED_PASSWORD=
